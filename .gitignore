# Dependencies and AdonisJS build
node_modules
build
tmp

# Données Postgres (bind mount de docker-compose) et dumps (npm run db:backup)
pgdata
backups

# Déclaration des agents (CC-141) — propre à chaque installation, peut porter des commandes
# locales. Seul agents.json.example (sans valeur réelle) est versionné.
agents.json

# Secrets
.env
.env.local
# ⚠️ .env.production porte les secrets réels lus par docker-compose.prod.yml (CC-73).
# Seul .env.production.example (sans valeurs) est versionné.
.env.production
.env.production.local
.env.development.local

# Frontend assets compiled code
public/assets

# Image de production exportée par `docker save` (§3 de docs/deploiement-nas.md).
# ~100 Mo, régénérable en une commande, et un `git add -A` l'embarquerait sans un mot.
*.tar

# Build tools specific
npm-debug.log
yarn-error.log

# Editors specific
.fleet
.idea
.vscode

# Platform specific
.DS_Store

# Claude Code — les skills du projet sont versionnés, l'état local ne l'est pas
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/youtrack-usage.log

# Skill task-observer (2026-08-08) : son propre SKILL.md écrit son journal hors du
# dépôt (~/.claude/projects/<id>/skill-observations/), jamais ici — cette ligne est
# une sécurité de secours si ce chemin se résolvait un jour mal, pas une correction
# d'un comportement observé.
skill-observations/

# Le skill task-observer lui-même : auto-installé localement, pas encore une décision
# du dépôt — exception à la ligne 42 (les skills du projet sont normalement versionnés).
.claude/skills/task-observer/

# Rapports d'audit produits localement (2026-08-18) : ils citent l'installation réelle
# — chemins, hôtes, valeurs de configuration — et ce dépôt est PUBLIC. Ils restent sur
# la machine ; ce qui doit survivre part dans un ticket ou dans la KB, jamais ici.
RAPPORT_SECURITE.md
